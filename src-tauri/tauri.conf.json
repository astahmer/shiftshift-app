{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "shiftshift",
	"version": "0.1.0",
	"identifier": "dev.shiftshift.tauri",
	"build": {
		"beforeDevCommand": "npm run dev",
		"beforeBuildCommand": "npm run build",
		"devUrl": "http://localhost:1420",
		"frontendDist": "../dist"
	},
	"app": {
		"macOSPrivateApi": true,
		"windows": [
			{
				"label": "panel",
				"title": "shiftshift",
				"width": 640,
				"height": 420,
				"visible": false,
				"decorations": false,
				"transparent": true,
				"alwaysOnTop": true,
				"skipTaskbar": true,
				"center": true
			}
		],
		"security": {
			"csp": null,
			"assetProtocol": {
				"enable": true,
				"scope": ["$APPDATA/images/*"]
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": ["icons/icon.png"],
		"license": "MIT",
		"licenseFile": "../LICENSE",
		"createUpdaterArtifacts": true
	},
	"plugins": {
		"updater": {
			"endpoints": ["https://github.com/astahmer/shiftshift-app/releases/latest/download/latest.json"],
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM3RTlDNTgyNDQzOTYxNTIKUldSU1lUbEVnc1hwTnlQTmZsbC9NZ2s2a3hBRzllWnRUYzNZV2dZcngyY2dFdzlMNnpqRzMxN0EK"
		}
	}
}
